{
  "version": "2.0.0",
  "tasks": [
    { "label": "Run devstack (GUI)", "type": "shell", "command": "cargo run --bin devstack", "problemMatcher": ["$rustc"] },
    { "label": "Test", "type": "shell", "command": "cargo test", "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "Build release", "type": "shell", "command": "cargo build --release", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "Build installer", "type": "shell", "command": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1", "problemMatcher": ["$rustc"] }
  ]
}
