; Generated by devstack - do not edit.
; Add your own settings to usr/php.ini (appended at the end, so they win).
; Toggle extensions from the PHP > Extensions menu.

[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = {{ -1 if php_modern_precision else 17 }}
expose_php = Off
max_execution_time = {{ php.max_execution_time }}
max_input_time = 120
max_input_vars = 5000
memory_limit = {{ php.memory_limit }}
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{ logs }}/php_errors.log"
html_errors = On
variables_order = "GPCS"
request_order = "GP"
register_argc_argv = Off
auto_globals_jit = On
post_max_size = {{ php.post_max_size }}
default_charset = "UTF-8"
extension_dir = "{{ php_dir }}/ext"
enable_dl = Off
cgi.force_redirect = 0
cgi.fix_pathinfo = 1
file_uploads = On
upload_tmp_dir = "{{ tmp }}/php/uploads"
upload_max_filesize = {{ php.upload_max_filesize }}
max_file_uploads = 50
allow_url_fopen = On
allow_url_include = Off
default_socket_timeout = 60
sys_temp_dir = "{{ tmp }}/php"

{% for e in php_extensions %}
extension={{ "php_" ~ e ~ ".dll" if php_ext_dll else e }}
{% endfor %}
{% for z in php_zend_extensions %}
zend_extension={{ "php_" ~ z ~ ".dll" if php_ext_dll else z }}
{% endfor %}

[Date]
date.timezone = {{ php.timezone }}

[mail function]
; Every email is caught by Mailpit: http://127.0.0.1:{{ mailpit_ui }}
SMTP = 127.0.0.1
smtp_port = {{ mailpit_smtp }}
sendmail_from = devstack@localhost
mail.add_x_header = Off

[Session]
session.save_handler = files
session.save_path = "{{ tmp }}/php/sessions"
session.use_strict_mode = 1
session.gc_maxlifetime = 1440

{% if cacert %}
[curl]
curl.cainfo = "{{ cacert }}"

[openssl]
openssl.cafile = "{{ cacert }}"

{% endif %}
[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 128
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0

{% if "xdebug" in php_zend_extensions %}
[xdebug]
xdebug.mode = debug,develop
xdebug.start_with_request = trigger
xdebug.client_port = 9003

{% endif %}
; ---------------- usr/php.ini ----------------
{{ usr_php_ini }}
