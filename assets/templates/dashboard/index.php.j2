<?php
// devstack dashboard (shown at http://localhost). To change it, copy this template to
// usr/templates/dashboard/index.php.j2 and edit the copy.
// Pages that reveal this computer's setup are only shown to this computer. That matters when
// "Other devices on your network" is on.
$local = in_array($_SERVER['REMOTE_ADDR'] ?? '', ['127.0.0.1', '::1'], true);
if (isset($_GET['phpinfo'])) {
    if (!$local) { http_response_code(403); exit('phpinfo() is only shown on this computer.'); }
    phpinfo(); exit;
}

$www = '{{ www | php }}';
$template = '{{ hostname_template | php }}';
$https = !empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off';
$scheme = $https ? 'https' : 'http';
$sites = [];
foreach (scandir($www) ?: [] as $d) {
    if ($d[0] === '.' || !is_dir("$www/$d")) continue;
    $label = trim(preg_replace('/[^a-z0-9-]+/', '-', strtolower($d)), '-');
    if ($label === '') continue;
    $sites[] = ['name' => $d, 'host' => str_replace('{name}', $label, $template)];
}
$pma = {{ 'true' if phpmyadmin_dir else 'false' }};
function e($s) { return htmlspecialchars($s, ENT_QUOTES); }
?><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>devstack</title>
<style>
  :root { --bg:#f6f7f9; --card:#fff; --ink:#1d2330; --muted:#677084; --line:#e3e6ec; --accent:#2f6fed; }
  @media (prefers-color-scheme: dark) { :root { --bg:#14171d; --card:#1c2029; --ink:#e7eaf0; --muted:#98a1b3; --line:#2a303c; --accent:#6f9bff; } }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; background:var(--bg); color:var(--ink); }
  main { max-width: 860px; margin: 0 auto; padding: 40px 20px 60px; }
  header { display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap; margin-bottom:24px; }
  h1 { margin:0; font-size:22px; letter-spacing:-.01em; }
  .meta { color:var(--muted); font-size:13px; }
  .links { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:28px; }
  .links a { padding:6px 12px; border:1px solid var(--line); border-radius:8px; background:var(--card); color:var(--ink); text-decoration:none; font-size:14px; }
  .links a:hover { border-color:var(--accent); }
  h2 { font-size:13px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin:0 0 10px; }
  ul { list-style:none; margin:0; padding:0; background:var(--card); border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  li { display:flex; justify-content:space-between; gap:12px; padding:12px 16px; border-top:1px solid var(--line); }
  li:first-child { border-top:0; }
  li a { color:var(--accent); text-decoration:none; font-weight:600; }
  li span { color:var(--muted); font-size:13px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .empty { padding:20px 16px; color:var(--muted); }
</style>
</head>
<body>
<main>
  <header>
    <h1>devstack</h1>
    <div class="meta">PHP <?= e(PHP_VERSION) ?> · <?= e($_SERVER['SERVER_SOFTWARE'] ?? '') ?></div>
  </header>
  <nav class="links">
    <?php if ($local): ?>
    <a href="?phpinfo=1">phpinfo()</a>
    <?php if ($pma): ?><a href="/phpmyadmin/">phpMyAdmin</a><?php endif; ?>
    <a href="http://127.0.0.1:{{ mailpit_ui }}/">Mailpit inbox</a>
    <?php endif; ?>
  </nav>
  <h2>Projects in www</h2>
  <ul>
    <?php if (!$sites): ?><li class="empty">No projects yet. Create a folder in <?= e($www) ?> or use Quick app.</li><?php endif; ?>
    <?php foreach ($sites as $s): ?>
      <li><a href="<?= e("$scheme://{$s['host']}") ?>"><?= e($s['host']) ?></a><span><?= e("$www/{$s['name']}") ?></span></li>
    <?php endforeach; ?>
  </ul>
</main>
</body>
</html>
