# Generated by devstack - do not edit. Put your own settings in usr/apache/*.conf
ServerRoot "{{ apache_dir }}"
DefaultRuntimeDir "{{ tmp }}/apache"
PidFile "{{ tmp }}/apache/httpd.pid"

Listen {{ bind }}{{ ports.http }}
{% if ssl %}
Listen {{ bind }}{{ ports.https }}
{% endif %}

{% for m in apache_modules %}
LoadModule {{ m }}_module modules/mod_{{ m }}.so
{% endfor %}

<IfModule mpm_winnt_module>
    ThreadsPerChild 150
    MaxConnectionsPerChild 0
</IfModule>

ServerName localhost
ServerAdmin admin@localhost
ServerSignature Off
ServerTokens Prod
TraceEnable Off
Timeout 300
KeepAlive On
HostnameLookups Off
AcceptFilter http none
AcceptFilter https none
EnableSendfile Off
EnableMMAP Off

ErrorLog "{{ logs }}/apache_error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "{{ logs }}/apache_access.log" combined

TypesConfig conf/mime.types
DirectoryIndex index.php index.html index.htm /__devstack/index.php

<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Directory "{{ www }}">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
    CGIPassAuth On
</Directory>

<Directory "{{ dashboard_dir }}">
    Require all granted
</Directory>

<Files ".ht*">
    Require all denied
</Files>

# Never serve dotfiles and dot-folders (.env, .git, ...), except .well-known.
RedirectMatch 404 "/\.(?!well-known)"

{% if php_apache_module %}
# PHP runs inside Apache (thread-safe PHP build). Its folder is put on Apache's PATH so
# extension DLLs (curl, openssl, ...) find their dependencies.
LoadModule {{ php_apache_module_name }} "{{ php_apache_module }}"
PHPIniDir "{{ php_ini_dir }}"
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
{% elif php_dir %}
# Fallback for non-thread-safe PHP builds: the php-cgi pool behind Apache's balancer.
# .htaccess rewrites to index.php (Laravel/WordPress pretty URLs) don't work this way;
# install a "ts" PHP build from Quick add so Apache can load PHP as a module.
<IfModule proxy_fcgi_module>
    ProxyFCGIBackendType GENERIC
    <Proxy "balancer://php">
{% for port in php_ports %}
        BalancerMember "fcgi://127.0.0.1:{{ port }}" timeout=300
{% endfor %}
    </Proxy>
    <FilesMatch "\.php$">
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:balancer://php"
        </If>
    </FilesMatch>
</IfModule>
{% endif %}

{% if ssl %}
<IfModule ssl_module>
    SSLSessionCache "shmcb:{{ tmp }}/apache/ssl_scache(512000)"
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
</IfModule>
{% endif %}

Include "{{ etc }}/apache/sites.conf"
IncludeOptional "{{ usr }}/apache/*.conf"
