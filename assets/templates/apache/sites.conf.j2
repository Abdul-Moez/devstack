# Generated by devstack - do not edit. Per-site overrides go in usr/sites.json
{% macro localhost() %}
    ServerName localhost
    DocumentRoot "{{ www }}"
    Alias /__devstack "{{ dashboard_dir }}"
{% if phpmyadmin_dir %}
    Alias /phpmyadmin "{{ phpmyadmin_dir }}"
    <Directory "{{ phpmyadmin_dir }}">
        AllowOverride All
        Require local
    </Directory>
{% endif %}
{% endmacro %}
{% macro site(s) %}
    ServerName {{ s.host }}
    ServerAlias *.{{ s.host }}{% for a in s.aliases %} {{ a }}{% endfor %}

    DocumentRoot "{{ s.docroot }}"
    <Directory "{{ s.docroot }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
        CGIPassAuth On
    </Directory>
{% endmacro %}

<VirtualHost *:{{ ports.http }}>
{{ localhost() }}
</VirtualHost>
{% if ssl %}

<VirtualHost *:{{ ports.https }}>
{{ localhost() }}
    SSLEngine on
    SSLCertificateFile "{{ localhost_cert }}"
    SSLCertificateKeyFile "{{ localhost_key }}"
</VirtualHost>
{% endif %}
{% for s in sites %}

<VirtualHost *:{{ ports.http }}>
{{ site(s) }}
</VirtualHost>
{% if s.ssl %}

<VirtualHost *:{{ ports.https }}>
{{ site(s) }}
    SSLEngine on
    SSLCertificateFile "{{ s.cert }}"
    SSLCertificateKeyFile "{{ s.key }}"
</VirtualHost>
{% endif %}
{% endfor %}
