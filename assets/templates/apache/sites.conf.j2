# Generated by devstack - do not edit. Per-site overrides go in usr/sites.json
{% macro localhost() %}
    ServerName localhost
    DocumentRoot "{{ www }}"
    # This catch-all host answers only when it is addressed as localhost, by this computer's
    # name or by IP address. Any other name means a web page pointed a domain of its own at
    # this computer ("DNS rebinding") so that its scripts could read your projects and
    # phpMyAdmin through your browser.
    <If "%{HTTP_HOST} !~ m#^(localhost{% if computer_name %}|{{ computer_name }}(\.local)?{% endif %}|[0-9.]+|\[[0-9a-f:.]+\])(:[0-9]+)?$#i">
        Require all denied
    </If>
    Alias /__devstack "{{ dashboard_dir }}"
{% if phpmyadmin_dir %}
    Alias /phpmyadmin "{{ phpmyadmin_dir }}"
    <Directory "{{ phpmyadmin_dir }}">
        AllowOverride All
        Require local
    </Directory>
{% endif %}
{% endmacro %}
{% macro site(s, scheme) %}
    ServerName {{ s.host }}
    ServerAlias *.{{ s.host }}{% for a in s.aliases %} {{ a }}{% endfor %}

    DocumentRoot "{{ s.docroot }}"
    <Directory "{{ s.docroot }}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
        CGIPassAuth On
    </Directory>
{% if s.proxy %}
    # Requests go to the app server set as "proxy" in usr/sites.json.
    ProxyPreserveHost On
    <IfModule headers_module>
        RequestHeader set X-Forwarded-Proto "{{ scheme }}"
    </IfModule>
    ProxyPass / {{ s.proxy }}/
    ProxyPassReverse / {{ s.proxy }}/
{% endif %}
{% endmacro %}

<VirtualHost *:{{ ports.http }}>
{{ localhost() }}
</VirtualHost>
{% if ssl %}

<VirtualHost *:{{ ports.https }}>
{{ localhost() }}
    SSLEngine on
    SSLCertificateFile "{{ localhost_cert }}"
    SSLCertificateKeyFile "{{ localhost_key }}"
</VirtualHost>
{% endif %}
{% for s in sites %}

<VirtualHost *:{{ ports.http }}>
{{ site(s, "http") }}
</VirtualHost>
{% if s.ssl %}

<VirtualHost *:{{ ports.https }}>
{{ site(s, "https") }}
    SSLEngine on
    SSLCertificateFile "{{ s.cert }}"
    SSLCertificateKeyFile "{{ s.key }}"
</VirtualHost>
{% endif %}
{% endfor %}
