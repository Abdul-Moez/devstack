# Generated by devstack - do not edit. Put your own settings in usr/nginx/*.conf
worker_processes  1;
error_log "{{ logs }}/nginx_error.log" warn;
pid "{{ tmp }}/nginx.pid";

events {
    worker_connections 1024;
}

http {
    include "{{ nginx_dir }}/conf/mime.types";
    default_type application/octet-stream;
    access_log "{{ logs }}/nginx_access.log";
    sendfile off;
    keepalive_timeout 65;
    server_names_hash_bucket_size 128;
    client_max_body_size {{ php.upload_max_filesize }};

    client_body_temp_path "{{ tmp }}/nginx/client_body";
    proxy_temp_path "{{ tmp }}/nginx/proxy";
    fastcgi_temp_path "{{ tmp }}/nginx/fastcgi";
    uwsgi_temp_path "{{ tmp }}/nginx/uwsgi";
    scgi_temp_path "{{ tmp }}/nginx/scgi";

    fastcgi_read_timeout 300;
    fastcgi_buffer_size 32k;
    fastcgi_buffers 16 16k;

    # PHP: a pool of php-cgi processes (each handles one request at a time).
    upstream php {
{% for port in php_ports %}
        server 127.0.0.1:{{ port }};
{% endfor %}
    }

    include "{{ etc }}/nginx/sites.conf";
    include "{{ usr }}/nginx/*.conf";
}
