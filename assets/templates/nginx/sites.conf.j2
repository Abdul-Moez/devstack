# Generated by devstack - do not edit. Per-site overrides go in usr/sites.json
{% macro php_block(script) %}
            include "{{ nginx_dir }}/conf/fastcgi_params";
            fastcgi_param SCRIPT_FILENAME {{ script }};
            fastcgi_pass php;
{% endmacro %}

server {
    listen {{ bind }}{{ ports.http }} default_server;
{% if ssl %}
    listen {{ bind }}{{ ports.https }} ssl default_server;
    ssl_certificate "{{ localhost_cert }}";
    ssl_certificate_key "{{ localhost_key }}";
{% endif %}
    server_name localhost;
    root "{{ www }}";
    index index.php index.html index.htm /__devstack/index.php;

    # This catch-all host answers only when it is addressed as localhost, by this computer's
    # name or by IP address. Any other name means a web page pointed a domain of its own at
    # this computer ("DNS rebinding") so that its scripts could read your projects and
    # phpMyAdmin through your browser.
    if ($host !~* "^(localhost{% if computer_name %}|{{ computer_name }}(\.local)?{% endif %}|[0-9.]+|\[[0-9a-f:.]+\])$") {
        return 403;
    }

    location ^~ /__devstack/ {
        alias "{{ dashboard_dir }}/";
        location ~ \.php$ {
            if (!-f $request_filename) {
                return 404;
            }
{{ php_block("$request_filename") }}
        }
    }
{% if phpmyadmin_dir %}

    location ^~ /phpmyadmin/ {
        alias "{{ phpmyadmin_dir }}/";
        index index.php;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        location ~ \.php$ {
            if (!-f $request_filename) {
                return 404;
            }
{{ php_block("$request_filename") }}
        }
    }
{% endif %}

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
{{ php_block("$document_root$fastcgi_script_name") }}
    }
}
{% for s in sites %}

server {
    listen {{ bind }}{{ ports.http }};
{% if s.ssl %}
    listen {{ bind }}{{ ports.https }} ssl;
    ssl_certificate "{{ s.cert }}";
    ssl_certificate_key "{{ s.key }}";
{% endif %}
    server_name {{ s.host }} *.{{ s.host }}{% for a in s.aliases %} {{ a }}{% endfor %};
    root "{{ s.docroot }}";

    location ~ /\.(?!well-known) {
        deny all;
    }
{% if s.proxy %}

    # Requests go to the app server set as "proxy" in usr/sites.json.
    location / {
        proxy_pass {{ s.proxy }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
{% else %}
    index index.php index.html index.htm;
    autoindex on;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
{{ php_block("$document_root$fastcgi_script_name") }}
    }
{% endif %}
}
{% endfor %}
